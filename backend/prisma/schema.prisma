generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User role enum: SUPER_ADMIN, ADMIN, USER
// User status: ACTIVE, SUSPENDED, EXPIRED, DISABLED
// Access types: COURSE, SUBJECT, NOTE
// Note status: PUBLISHED, DRAFT, ARCHIVED
// Note visibility: RESTRICTED_PAID, PUBLIC_PREVIEW
// Payment status: PENDING, PAID, FAILED, REFUNDED, CANCELLED

model User {
  id            String       @id @default(uuid())
  username      String       @unique
  fullName      String
  passwordHash  String
  role          String       @default("USER") // "SUPER_ADMIN" | "ADMIN" | "USER"
  status        String       @default("ACTIVE") // "ACTIVE" | "SUSPENDED" | "EXPIRED" | "DISABLED"
  maxDevices    Int          @default(1)
  accessExpiry  DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  createdById   String?
  createdBy     User?        @relation("AdminCreatedUsers", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers  User[]       @relation("AdminCreatedUsers")

  createdCourses Course[]    @relation("AdminCreatedCourses")
  createdNotes   Note[]      @relation("AdminCreatedNotes")

  sessions      Session[]
  userAccess    UserAccess[]
  payments      Payment[]
  activityLogs  ActivityLog[]
  recentViews   RecentView[]
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token            String    @unique
  deviceIdentifier String
  deviceName       String
  browser          String?
  os               String?
  ipAddress        String?
  lastActiveAt     DateTime  @default(now())
  expiresAt        DateTime
  isRevoked        Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@index([deviceIdentifier])
}

model Course {
  id          String       @id @default(uuid())
  title       String
  code        String       @unique
  description String?
  coverImage  String?
  status      String       @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  createdById String?
  createdBy   User?        @relation("AdminCreatedCourses", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  semesters   Semester[]
  notes       Note[]
  packages    PackageCourse[]
  userAccess  UserAccess[]

  @@index([createdById])
}

model Semester {
  id        String    @id @default(uuid())
  title     String
  order     Int       @default(1)
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subjects  Subject[]
  notes     Note[]

  @@index([courseId])
}

model Subject {
  id          String       @id @default(uuid())
  title       String
  code        String
  description String?
  icon        String?
  semesterId  String
  semester    Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  topics      Topic[]
  notes       Note[]
  packages    PackageSubject[]
  userAccess  UserAccess[]

  @@index([semesterId])
}

model Topic {
  id          String    @id @default(uuid())
  title       String
  order       Int       @default(1)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  notes       Note[]

  @@index([subjectId])
}

model Note {
  id          String       @id @default(uuid())
  title       String
  description String?
  content     String       // Educational notes content (Rich Markdown/HTML text)
  coverImage  String?
  filePath    String?      // Private backend storage path if file is attached
  fileType    String?      @default("MARKDOWN") // "MARKDOWN" | "PDF" | "DOCUMENT"
  status      String       @default("PUBLISHED") // "PUBLISHED" | "DRAFT" | "ARCHIVED"
  visibility  String       @default("RESTRICTED_PAID") // "RESTRICTED_PAID" | "PUBLIC_PREVIEW"
  
  courseId    String?
  course      Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  semesterId  String?
  semester    Semester?    @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  subjectId   String?
  subject     Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId     String?
  topic       Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?        @relation("AdminCreatedNotes", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userAccess  UserAccess[]
  recentViews RecentView[]

  @@index([courseId])
  @@index([subjectId])
  @@index([topicId])
  @@index([status])
  @@index([createdById])
}

model UserAccess {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessType String    // "COURSE" | "SUBJECT" | "NOTE"
  courseId   String?
  course     Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subjectId  String?
  subject    Subject?  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  noteId     String?
  note       Note?     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  startDate  DateTime  @default(now())
  expiryDate DateTime
  status     String    @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "REVOKED"
  grantedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([subjectId])
  @@index([noteId])
}

model Package {
  id           String           @id @default(uuid())
  name         String
  description  String?
  price        Float
  durationDays Int              @default(30)
  status       String           @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  courses      PackageCourse[]
  subjects     PackageSubject[]
  payments     Payment[]
}

model PackageCourse {
  id        String   @id @default(uuid())
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([packageId, courseId])
}

model PackageSubject {
  id        String   @id @default(uuid())
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([packageId, subjectId])
}

model Payment {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId      String?
  package        Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  amount         Float
  paymentMethod  String    // "Bank Transfer", "JazzCash", "EasyPaisa", "Manual / Cash", "Other"
  transactionRef String
  paymentDate    DateTime  @default(now())
  expiryDate     DateTime?
  status         String    @default("PAID") // "PENDING" | "PAID" | "FAILED" | "REFUNDED" | "CANCELLED"
  notes          String?
  recordedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  type      String   @default("INFO") // "INFO" | "WARNING" | "SUCCESS" | "URGENT"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id           String   @id @default(uuid())
  platform     String   // "FACEBOOK" | "INSTAGRAM" | "WHATSAPP"
  title        String
  url          String
  isEnabled    Boolean  @default(true)
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   @default("GENERAL") // "GENERAL" | "SECURITY" | "CONTENT" | "SYSTEM"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username  String?
  action    String   // "LOGIN", "LOGOUT", "USER_CREATED", "ACCESS_GRANTED", "SESSION_REVOKED", etc.
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model RecentView {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, noteId])
  @@index([userId])
}

model UploadedFile {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimetype     String
  size         Int
  data         String   // Base64-encoded binary payload
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([createdById])
  @@index([createdAt])
}

