PORT=5000
NODE_ENV=production
# For PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/alnotes?schema=public"
# For SQLite (default development):
DATABASE_URL="file:./dev.db"
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
SESSION_SECRET=your_session_secret_key_here
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_this_secure_password
DEFAULT_ADMIN_NAME="System Administrator"
STORAGE_PROVIDER=local
STORAGE_PATH="./uploads"
# Optional object storage (S3/R2/Supabase)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

